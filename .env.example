# ── Telegram (REQUIRED) ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to receive reports and send commands
# Use @userinfobot in Telegram to find your chat/user IDs
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# ── Meta Ads (Phase 2) ─────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Set this when META_AD_ACCOUNT_ID is a shared/agency ad account with other brands'
# campaigns living alongside this one's (e.g. Nowa's account also has Pawcast
# campaigns). Filters campaign/adset/ad insights and ad creatives at ingest time so
# another brand's spend never lands in this dashboard's DB. Include the exact
# separator your campaign names use, e.g. "Nowa | ". Leave blank (default) for a
# single-brand account — no filtering.
META_CAMPAIGN_NAME_PREFIX=

# ── Meta Pixel health (Phase C: Tracking Health page) ──────────────────────────
# Leave blank to disable pixel health ingestion — clean no-op, like Shopify/Sheets.
# Nowa's pixel/dataset ID is 4477775862499139 (documented here as a comment only —
# never hardcoded as a default in code). Set this to enable per-event browser/server
# counts (and best-effort EMQ, when the Dataset Quality API is reachable with this
# token's access tier) on the Tracking Health dashboard page.
META_PIXEL_ID=

# ── Google Analytics 4 (Phase 3) ───────────────────────────────────────────────
GA4_PROPERTY_ID=
# Path to your GA4 service account JSON key file
GA4_SERVICE_ACCOUNT_JSON=./secrets/ga4.json

# ── Shopify (funnel-v3: preorder purchases) ────────────────────────────────────
# Leave both blank to disable — Shopify ingest is a clean no-op (like Sheets/Sentry).
# Custom-app Admin API access token (Settings > Apps and sales channels > Develop apps).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01
# Two expressions of ONE cutoff for pre-launch/test orders. Keep them in step:
# set the number to the first real order, and the date to that order's date.
#
# Why two: shopify_orders stores Shopify's internal numeric id, not the "#1020"
# order NAME, so the date-keyed tables can only be cut by date. The Orders page
# reads shopify_order_journey, which does carry the name, so it cuts exactly.
#
# ORDERS_VALID_FROM — ISO date (YYYY-MM-DD). shopify_orders rows dated before this
# are excluded from every query that counts/sums orders. Query-time filter only,
# no rows are ever deleted. Empty (default) = no filtering.
ORDERS_VALID_FROM=
# ORDERS_MIN_ORDER_NUMBER — orders numbered below this are excluded on the Orders
# page. 0 (default) = no filtering. Preferred over a date where available: the
# order number is the real identity of the cutoff, and a date would not catch a
# test order placed after launch.
ORDERS_MIN_ORDER_NUMBER=0

# ── Email leads sheet (Preorder Leads Dashboard) ───────────────────────────────
# The spreadsheet ID of the Preorder Leads Dashboard (a DIFFERENT sheet from the
# legacy GOOGLE_SHEETS_SPREADSHEET_ID stripe one). Blank = clean no-op, so the
# Overview "Email leads" section simply hides itself.
#
# Setup: share the sheet (Viewer is enough) with the same service-account email
# already used for GA4 — the address in GOOGLE_SERVICE_ACCOUNT_JSON_PATH's
# client_email field. Without that share the pull fails with a 403.
#
# Tabs are matched by header signature, not by name, so renaming or reordering
# tabs is safe; adding a second tab with an identical header is not.
GOOGLE_SHEETS_LEADS_SPREADSHEET_ID=
# Comma-separated substrings that mark an address as internal/test rather than a
# real lead — excluded from every number the dashboard reports off this sheet.
# Matched case-insensitively anywhere in the address, so a bare domain also catches
# plus-addressing (huyle+1@resonancetech.co) and any TLD (nowaplanet.*). Rows are
# stored either way and only flagged, so editing this list re-classifies on the
# next pull with no backfill.
#
# The trailing entries are name substrings, not domains: they cover two teammates'
# test series (tdnghia.sdh221@hcmut.edu.vn, tradanghi1999chung/chuyennganh/try2@
# gmail.com; tai@resonancetech.co, tai@tester.com, contact.taihoang@gmail.com).
# Being substrings they would also exclude a real lead whose address contained
# them — fine while campaigns target US parents, narrow this if that changes.
# Note "tai@" and "taihoang", not a bare "tai": "tai" sits inside ordinary words US
# parents use in handles (mountain, retail, detail, captain), and that kind of false
# positive is silent — the lead count just reads low, with no error anywhere.
LEADS_INTERNAL_EMAIL_PATTERNS=resonancetech.co,nowaplanet,testingthis.com,example.com,nghia,tradanghi,tai@,taihoang,tester

# ── Funnel v3 config (GA4 event-level ingestion) ───────────────────────────────
# Comma-separated GA4 event names to pull event-level counts for (segmented by the
# lp_slug custom dimension). Leave blank to use the default funnel + quiz event list.
GA4_EVENT_LIST=
PRIMARY_CONVERSION_EVENT=begin_checkout
PURCHASE_EVENT=purchase
LEAD_EVENT=lead_submit

# ── Anthropic (Phase 4) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Monthly spend ceiling for AI chat (USD). Default $20.
ANTHROPIC_MONTHLY_BUDGET_USD=20.0

# ── MMM (Phase 8) ──────────────────────────────────────────────────────────────
# MMM: monetary value of one deposit in USD. Set to 0 (default) to report in
# "deposits per $1000 spend" units instead of true ROAS. (D-09)
DEPOSIT_VALUE_USD=0.0

# ── Sentry (Phase 5 — optional) ────────────────────────────────────────────────
# Leave blank to disable error reporting. Get DSN from sentry.io (free tier).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Dead-man's-switch (Phase 5 — optional) ─────────────────────────────────────
# healthchecks.io ping URL. Leave blank to disable. Set period=24h, grace=2h.
HEARTBEAT_URL=

# ── Streamlit Dashboard (Phase 6 — optional) ──────────────────────────────────
# Single shared password for the Streamlit dashboard.
# Leave blank for open access (local dev only — do NOT leave blank in production).
DASHBOARD_PASSWORD=

# Target Cost-per-Deposit (CPD) in USD for TIER tag classification.
# 0.0 (default) hides the TIER column. Set a positive number (e.g. 25.0) to
# enable SCALE / MAINTAIN / REDUCE / PAUSED tags on the campaign table.
CPD_TARGET=0.0

# ── Application ────────────────────────────────────────────────────────────────
# Local dev: use a relative path. Docker/server: /data/metrics.db
DB_PATH=./data/metrics.db
LOG_LEVEL=INFO
# Your local timezone for report scheduling, e.g. Europe/London, America/New_York
REPORT_TIMEZONE=UTC
